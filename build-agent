#!/usr/bin/env python3

import os
from pathlib import Path
import subprocess


def find_miqt_payloads(source_cache: Path) -> list[Path]:
    result = subprocess.run(
        [
            "rg",
            "-a",
            "-l",
            "-0",
            r"github\.com/mappu/miqt|/miqt@|miqt/qt6|QApplication",
            str(source_cache),
            "--glob",
            "*-d",
        ],
        stdout=subprocess.PIPE,
        check=False,
    )
    if result.returncode not in (0, 1):
        raise subprocess.CalledProcessError(result.returncode, result.args)
    return [Path(os.fsdecode(name)) for name in result.stdout.split(b"\0") if name]


def find_action_records(source_cache: Path, output_ids: set[str]) -> list[Path]:
    records = []
    for record in source_cache.glob("*/*-a"):
        try:
            fields = record.read_text().split()
        except (OSError, UnicodeDecodeError):
            continue
        if len(fields) >= 3 and fields[2] in output_ids:
            records.append(record)
    return records


def seed_miqt_cache(source_cache: Path, build_cache: Path) -> None:
    if source_cache == build_cache or not source_cache.is_dir():
        return

    payloads = find_miqt_payloads(source_cache)
    output_ids = {payload.name.removesuffix("-d") for payload in payloads}
    cache_files = payloads + find_action_records(source_cache, output_ids)
    if not cache_files:
        return

    build_cache.mkdir(parents=True, exist_ok=True)
    file_list = b"\0".join(
        os.fsencode(path.relative_to(source_cache)) for path in cache_files
    ) + b"\0"
    subprocess.run(
        [
            "rsync",
            "-a",
            "--from0",
            "--files-from=-",
            f"{source_cache}/",
            f"{build_cache}/",
        ],
        input=file_list,
        check=True,
    )


def main() -> None:
    source_cache = Path(
        subprocess.run(
            ["go", "env", "GOCACHE"],
            check=True,
            capture_output=True,
            text=True,
        ).stdout.strip()
    )
    build_cache = Path(
        os.environ.get(
            "AYANDICT_GOCACHE",
            str(Path(os.environ.get("TMPDIR", "/tmp")) / "ayandict-go-cache"),
        )
    )

    seed_miqt_cache(source_cache, build_cache)

    env = os.environ.copy()
    env.update(GOCACHE=str(build_cache), GOMAXPROCS="4", CGO_ENABLED="1")
    subprocess.run(
        ["go", "build", "-ldflags", "-s -w", "-trimpath"],
        env=env,
        check=True,
    )


if __name__ == "__main__":
    main()
